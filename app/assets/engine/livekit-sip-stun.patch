+// sdpPort is the port the other side should send to (the outside port when known).
+func (p *mediaPort) sdpPort() int {
+	if p.externalPort > 0 {
+		return p.externalPort
+	}
+	return p.Port()
+}
+
+// stunMappedPort asks a STUN server, from conn itself, which outside port it appears on.
+func stunMappedPort(conn UDPConn, server string) int {
+	ua, err := net.ResolveUDPAddr("udp4", server)
+	if err != nil {
+		return 0
+	}
+	req := make([]byte, 20)
+	binary.BigEndian.PutUint16(req[0:], 1)
+	binary.BigEndian.PutUint32(req[4:], 0x2112A442)
+	_, _ = rand.Read(req[8:20])
+	buf := make([]byte, 1500)
+	defer conn.SetReadDeadline(time.Time{})
+	for try := 0; try < 3; try++ {
+		if _, err := conn.WriteToUDPAddrPort(req, ua.AddrPort()); err != nil {
+			return 0
+		}
+		_ = conn.SetReadDeadline(time.Now().Add(700 * time.Millisecond))
+		n, _, err := conn.ReadFromUDPAddrPort(buf)
+		if err != nil || n < 20 {
+			continue
+		}
+		for i := 20; i+4 <= n; {
+			t := binary.BigEndian.Uint16(buf[i:])
+			l := int(binary.BigEndian.Uint16(buf[i+2:]))
+			if i+4+l > n {
+				break
+			}
+			v := buf[i+4 : i+4+l]
+			if t == 0x0020 && l >= 8 {
+				return int(binary.BigEndian.Uint16(v[2:]) ^ 0x2112)
+			}
+			if t == 0x0001 && l >= 8 {
+				return int(binary.BigEndian.Uint16(v[2:]))
+			}
+			i += 4 + l + (4-l%4)%4
+		}
+	}
+	return 0
+}
